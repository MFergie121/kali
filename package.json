{
  "name": "kali-afl",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "lint": "eslint .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:clear": "npx tsx --env-file=.env scripts/clear-afl-data.ts",
    "db:hash-keys": "npx tsx --env-file=.env scripts/hash-api-keys.ts",
    "db:seed:dev": "bash scripts/seed-dev-db-from-prod.sh",
    "mcp:dev": "tsx watch --env-file=.env mcp/server.ts",
    "mcp:start": "tsx mcp/server.ts",
    "mcp:check": "tsc -p mcp/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^0.561.0",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^25.9.1",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10.4.0",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.2",
    "svelte-eslint-parser": "^1.6.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "drizzle-orm": "^0.45.1",
    "jose": "^6.2.0",
    "mode-watcher": "^1.1.0",
    "node-html-parser": "^7.1.0",
    "postgres": "^3.4.8",
    "svelte-sonner": "^1.1.0",
    "tsx": "^4.22.4",
    "zod": "^4.4.3"
  }
}
